{% extends "base.html.j2" %}
{% import "_row.html.j2" as r with context %}
{% block content %}
<h1>Job Search</h1>

<div class="bar">
  <form method="post" action="/actions/search">
    <input type="hidden" name="return_to" value="search">
    <button type="submit" {{ 'disabled' if not search_available or poll_progress.running else '' }}>Search now</button>
  </form>
  <form method="post" action="/actions/refresh">
    <input type="hidden" name="return_to" value="search">
    <button type="submit">Update current jobs</button>
  </form>
  <form method="post" action="/actions/rescore">
    <input type="hidden" name="return_to" value="search">
    <button type="submit" {{ 'disabled' if ai_progress.running else '' }}
      title="Re-apply the rules to every job, then have the model read only the postings it has never read. Already-read jobs are left alone.">
      Read new{% if unread_count %} ({{ unread_count }}){% endif %}</button>
  </form>
  <form method="post" action="/actions/rescore"
    onsubmit="return confirm('Re-read all {{ readable_count }} postings? This spends {{ readable_count }} model calls and takes around {{ (readable_count * 7 / 60)|round|int }} minutes.')">
    <input type="hidden" name="return_to" value="search">
    <input type="hidden" name="force" value="1">
    <button type="submit" {{ 'disabled' if ai_progress.running else '' }}
      title="Read every posting again from scratch, including ones already read. Do this after changing the screening prompt or your profile — an old verdict was reached under different instructions and will not update on its own.">
      Reread all{% if readable_count %} ({{ readable_count }}){% endif %}</button>
  </form>
</div>
<p class="sub" id="poll-status">{{ poll_progress.text }}</p>
<p class="sub" id="ai-status">{{ ai_progress.text }}</p>
{% if ai_progress.failures %}
<details class="sub"><summary>Why {{ ai_progress.failed }} failed</summary>
  <ul>{% for line in ai_progress.failures %}<li>{{ line }}</li>{% endfor %}</ul>
</details>
{% endif %}
{% if ai_progress.running %}
<p class="sub"><strong>Reading the {{ ai_progress.total }} posting(s) the model had not
read before.</strong> Jobs already carrying an AI score are untouched. This runs
in the background at roughly 11 seconds each, four at a time.</p>
{% endif %}
{% if unmatched %}
<details class="sub">
  <summary>{{ unmatched|length }} spotted job(s) no longer match your role
  families</summary>
  <p>Tightening the keyword lists does not reach backwards, and rescoring never
  archives on its own — ruling a job out is your call. These are the ones the
  rules would not store today.</p>
  <ul>{% for job in unmatched %}<li><a href="{{ job.url }}" target="_blank"
    rel="noopener noreferrer">{{ job.title }}</a></li>{% endfor %}</ul>
  <form method="post" action="/actions/archive-unmatched"
    onsubmit="return confirm('Archive {{ unmatched|length }} job(s) that no longer match? They stay in the Archive tab and can be restored.')">
    <input type="hidden" name="return_to" value="search">
    <button type="submit">Archive these {{ unmatched|length }}</button>
  </form>
</details>
{% endif %}
{% if search_available %}
<p class="sub">Searching polls {{ pollable|length }} employer(s):
{{ pollable|join(', ') }}.
{% if unwatched_count %}The other {{ unwatched_count }} are not polled — check those
yourself and add by URL below.{% endif %}
Only postings matching your role families are stored; the rest are counted and
discarded.</p>
{% else %}
<p class="sub">No employer has polling enabled yet. Set <code>ats</code>,
<code>ats_endpoint</code> and <code>poll_enabled</code> in
<code>config/employers.yaml</code>, then run <code>jobs sync-employers</code>.
Until then, add jobs by URL below.</p>
{% endif %}

<h2>LinkedIn <span class="sub">(manual channel)</span></h2>
<p class="sub">LinkedIn has no public jobs API and its terms forbid scraping, so
these searches cannot be polled. What the tracker does instead is build the
searches for you — each link is one of your role terms in one target city,
restricted to the last 7 days and sorted newest first. Open a few, then add
anything worth keeping with the form below.</p>
{% for location, links in linkedin_groups %}
<details>
  <summary>{{ location }} <span class="sub">({{ links|length }} searches)</span></summary>
  <p>{% for link in links %}<a href="{{ link.url }}" target="_blank"
     rel="noopener noreferrer">{{ link.term }}</a>{{ ' · ' if not loop.last }}{% endfor %}</p>
</details>
{% else %}
<p class="empty">No LinkedIn searches — add <code>poll_search_terms</code> to
<code>config/scoring.yaml</code> and cities to <code>config/cities.yaml</code>.</p>
{% endfor %}

{% if consultancy_groups %}
<h2>Consultancies <span class="sub">(manual channel)</span></h2>
<p class="sub">Engineering consultancies staff people into Airbus, Thales, ESA
and the OEMs, and they advertise on LinkedIn far more than on their own boards.
The ones with a public board — ALTEN, Assystem, Scalian, ATG Europe — are
polled with everything else and are not listed here. These are the rest: one
search per firm per domain, last 7 days, newest first.</p>
{% for company, links in consultancy_groups %}
<details>
  <summary>{{ company }} <span class="sub">({{ links|length }} searches)</span></summary>
  <p>{% for link in links %}<a href="{{ link.url }}" target="_blank"
     rel="noopener noreferrer">{{ link.term }}</a>{{ ' · ' if not loop.last }}{% endfor %}</p>
</details>
{% endfor %}
{% endif %}

<h2>Add a job</h2>
<p class="sub">For anything the pollers cannot reach — LinkedIn, a PDF advert,
a professor's page. Paste the posting text below: it is what gets scored and
what the model reads later. Without it the tracker has to re-fetch the URL,
which is exactly what fails on these sites. With text pasted, the entry
survives even if the URL cannot be fetched at all.</p>
<form method="post" action="/jobs">
<div class="bar">
  <div><label for="url">Posting URL</label>
    <input id="url" name="url" size="42" required></div>
  <div><label for="title">Title</label>
    <input id="title" name="title" size="30"
           placeholder="left blank: taken from the page"></div>
  <div><label for="employer">Employer</label>
    <input id="employer" name="employer" list="employers" required>
    <datalist id="employers">
      {% for name in employers %}<option value="{{ name }}">{% endfor %}
    </datalist></div>
  <div><label for="city">City</label><input id="city" name="city" size="12"></div>
  <div><label for="country">Country</label><input id="country" name="country" size="4"></div>
  <div><label for="level">Level</label>
    <select id="level" name="level">
      <option value="junior">junior</option><option value="phd">phd</option>
    </select></div>
  <div><label for="tags">Tags</label><input id="tags" name="tags" size="12"></div>
</div>
<label for="description">Posting text <span class="sub">(paste it — scored and
  read by the model; leave blank to fetch the URL instead)</span></label>
<textarea id="description" name="description" rows="8"></textarea>
<p><button type="submit">Add</button></p>
</form>

<h2>Spotted <span class="sub">({{ rows|length }})</span>
  <span class="sub">sort:
  {% for key, label in sorts %}{% if key == sort %}<strong>{{ label }}</strong>{%
    else %}<a href="/search?sort={{ key }}">{{ label }}</a>{% endif %}{{
    ' · ' if not loop.last }}{% endfor %}</span></h2>
<p class="sub">{% if sort == 'ai' %}The model's reading of the posting body, on
its own. Jobs it has not read yet are last.{% elif sort == 'score' %}The
rule-based score from the title, compensation and city, before the model read
anything.{% else %}The model's fit folded into your compensation and
quality-of-life weights — what to apply to, rather than what matches best.{%
endif %}</p>
{% if rows %}
<table>
  <tr><th>Job</th><th>Compensation</th><th>Score</th><th>Triage</th></tr>
  {% for row in rows %}
  <tr class="{{ 'new' if row.is_new else '' }}">
    <td>{{ r.identity(row) }}</td>
    <td>{{ row.comp_label }}</td>
    <td>{{ r.scorecell(row.job) }}{{ r.ai(row, 'search') }}</td>
    <td>{{ r.triage(row.job, 'search') }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}<p class="empty">Nothing spotted. Add one above.</p>{% endif %}

<script>
// Keep the two status lines current while a search or a read is going. Only
// those lines are touched: a reload here would wipe a half-typed "Add a job"
// form and jump you back to the top every couple of seconds.
(function () {
  var poll = document.getElementById('poll-status');
  var ai = document.getElementById('ai-status');
  var timer = null;
  var wasSearching = false;

  function stop() { if (timer) { clearInterval(timer); timer = null; } }

  function tick() {
    fetch('/api/progress')
      .then(function (r) { return r.json(); })
      .then(function (d) {
        poll.textContent = d.poll.text;
        ai.textContent = d.ai.text;
        // A finished search has spotted rows this page never rendered, so the
        // table below is stale. Reload only on that transition — a page opened
        // long after the last search must not reload itself forever.
        if (wasSearching && !d.poll.running) { window.location.reload(); return; }
        wasSearching = d.poll.running;
        if (!d.poll.running && !d.ai.running) stop();
      })
      .catch(stop);  // server stopped — go quiet rather than retry forever
  }

  timer = setInterval(tick, 2000);
  tick();
})();
</script>
{% endblock %}
