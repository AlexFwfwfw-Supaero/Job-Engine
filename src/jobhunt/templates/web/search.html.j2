{% extends "base.html.j2" %}
{% import "_row.html.j2" as r with context %}
{% block content %}
<h1>Job Search</h1>

<div class="bar">
  <form method="post" action="/actions/search">
    <input type="hidden" name="return_to" value="search">
    <button type="submit" {{ 'disabled' if not search_available else '' }}>Search now</button>
  </form>
  <form method="post" action="/actions/refresh">
    <input type="hidden" name="return_to" value="search">
    <button type="submit">Update current jobs</button>
  </form>
  <form method="post" action="/actions/rescore">
    <input type="hidden" name="return_to" value="search">
    <button type="submit" title="Re-apply the rules, then have the model read every unread posting">
      Rescore all</button>
  </form>
</div>
{% if ai_progress.running %}
<p class="sub"><strong>Reading {{ ai_progress.total }} posting(s) with the model.</strong>
This runs in the background at roughly 11 seconds each, four at a time.
Reload this page to see scores appear.</p>
{% elif ai_progress.done %}
<p class="sub">Model read {{ ai_progress.done }} posting(s){% if ai_progress.failed %},
{{ ai_progress.failed }} failed{% endif %}.</p>
{% endif %}
{% if search_available %}
<p class="sub">Searching polls {{ pollable|length }} employer(s):
{{ pollable|join(', ') }}.
{% if unwatched_count %}The other {{ unwatched_count }} are not polled — check those
yourself and add by URL below.{% endif %}
Only postings matching your role families are stored; the rest are counted and
discarded.</p>
{% else %}
<p class="sub">No employer has polling enabled yet. Set <code>ats</code>,
<code>ats_endpoint</code> and <code>poll_enabled</code> in
<code>config/employers.yaml</code>, then run <code>jobs sync-employers</code>.
Until then, add jobs by URL below.</p>
{% endif %}

<h2>LinkedIn <span class="sub">(manual channel)</span></h2>
<p class="sub">LinkedIn has no public jobs API and its terms forbid scraping, so
these searches cannot be polled. What the tracker does instead is build the
searches for you — each link is one of your role terms in one target city,
restricted to the last 7 days and sorted newest first. Open a few, then add
anything worth keeping with the form below.</p>
{% for location, links in linkedin_groups %}
<details>
  <summary>{{ location }} <span class="sub">({{ links|length }} searches)</span></summary>
  <p>{% for link in links %}<a href="{{ link.url }}" target="_blank"
     rel="noopener noreferrer">{{ link.term }}</a>{{ ' · ' if not loop.last }}{% endfor %}</p>
</details>
{% else %}
<p class="empty">No LinkedIn searches — add <code>poll_search_terms</code> to
<code>config/scoring.yaml</code> and cities to <code>config/cities.yaml</code>.</p>
{% endfor %}

{% if consultancy_groups %}
<h2>Consultancies <span class="sub">(manual channel)</span></h2>
<p class="sub">Engineering consultancies staff people into Airbus, Thales, ESA
and the OEMs, and they advertise on LinkedIn far more than on their own boards.
The ones with a public board — ALTEN, Assystem, Scalian, ATG Europe — are
polled with everything else and are not listed here. These are the rest: one
search per firm per domain, last 7 days, newest first.</p>
{% for company, links in consultancy_groups %}
<details>
  <summary>{{ company }} <span class="sub">({{ links|length }} searches)</span></summary>
  <p>{% for link in links %}<a href="{{ link.url }}" target="_blank"
     rel="noopener noreferrer">{{ link.term }}</a>{{ ' · ' if not loop.last }}{% endfor %}</p>
</details>
{% endfor %}
{% endif %}

<h2>Add a job</h2>
<form method="post" action="/jobs" class="bar">
  <div><label for="url">Posting URL</label>
    <input id="url" name="url" size="42" required></div>
  <div><label for="employer">Employer</label>
    <input id="employer" name="employer" list="employers" required>
    <datalist id="employers">
      {% for name in employers %}<option value="{{ name }}">{% endfor %}
    </datalist></div>
  <div><label for="city">City</label><input id="city" name="city" size="12"></div>
  <div><label for="country">Country</label><input id="country" name="country" size="4"></div>
  <div><label for="level">Level</label>
    <select id="level" name="level">
      <option value="junior">junior</option><option value="phd">phd</option>
    </select></div>
  <div><label for="tags">Tags</label><input id="tags" name="tags" size="12"></div>
  <button type="submit">Add</button>
</form>

<h2>Spotted <span class="sub">({{ rows|length }})</span></h2>
{% if rows %}
<table>
  <tr><th>Job</th><th>Compensation</th><th>Score</th><th>Triage</th></tr>
  {% for row in rows %}
  <tr>
    <td>{{ r.identity(row) }}</td>
    <td>{{ row.comp_label }}</td>
    <td>{{ r.scorecell(row.job) }}{{ r.ai(row, 'search') }}</td>
    <td>{{ r.triage(row.job, 'search') }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}<p class="empty">Nothing spotted. Add one above.</p>{% endif %}
{% endblock %}
