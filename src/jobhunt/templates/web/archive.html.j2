{% extends "base.html.j2" %}
{% import "_row.html.j2" as r with context %}
{% block content %}
<h1>Archive <span class="sub">({{ rows|length }})</span></h1>
<p class="sub">Recurring reasons here are candidates for
<code>negative_keywords</code> in config/scoring.yaml.</p>
{% if rows %}
<table>
  <tr><th>Job</th><th>Stage</th><th>Reason</th><th></th></tr>
  {% for row in rows %}
  <tr>
    <td>{{ r.identity(row) }}</td>
    <td>{{ row.job.stage.value }}</td>
    <td>{{ row.job.dismiss_reason or '—' }}</td>
    <td>
      <form class="inline" method="post" action="/jobs/{{ row.job.id }}/restore">
        <input type="hidden" name="return_to" value="archive">
        <button type="submit">Restore</button>
      </form>
    </td>
  </tr>
  {% endfor %}
</table>
{% else %}<p class="empty">Nothing archived.</p>{% endif %}
{% endblock %}
